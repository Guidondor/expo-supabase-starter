# Supabase — copy this file to `.env` and fill in your project's values.
# Dashboard → Project Settings → Data API / API Keys.
# `.env` is NEVER committed (it's in .gitignore).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — URL of the web page that handles password reset (the email link
# points here). Leave empty if you don't have a web deploy yet; the reset email
# still uses the Redirect URL configured in Supabase → Auth → URL Configuration.
EXPO_PUBLIC_RESET_REDIRECT_URL=
